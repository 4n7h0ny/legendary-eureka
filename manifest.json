{
  "manifest_version": 3,
  "name": "ChatGPT Read Aloud Downloader",
  "version": "1.1.0",
  "description": "Adds a download button for ChatGPT read-aloud audio and saves the file when you click it.",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
