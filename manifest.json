{
  "manifest_version": 3,
  "name": "ChatGPT Read Aloud Downloader",
  "version": "0.1.0",
  "description": "Adds a button next to the message menu to download ChatGPT read-aloud audio.",
  "permissions": ["downloads", "activeTab"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/styles.css"]
    }
  ]
}
